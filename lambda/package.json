{
  "name": "aerolopa-lambda",
  "version": "1.5.0",
  "private": true,
  "description": "Serves the seatmap and layouts functions from one AWS Lambda Function URL",
  "author": "mypreflight",
  "license": "Unlicense",
  "scripts": {
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --keep-names --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.2"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false
  }
}
