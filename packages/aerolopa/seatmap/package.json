{
  "name": "aerolopa-seatmap",
  "version": "1.4.3",
  "description": "AeroLOPA seat map fetcher, deployed as a DigitalOcean Function",
  "author": "mypreflight",
  "license": "Unlicense",
  "main": "lib/function.js",
  "scripts": {
    "build": "./build.sh",
    "start:dev": "TS_NODE_PROJECT=tsconfig.tests.json node --watch -r ts-node/register scripts/dev-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test:functional": "TS_NODE_PROJECT=tsconfig.tests.json cucumber-js --require-module ts-node/register/transpile-only --require 'features/_context/**/*.ts' --fail-fast",
    "mock:emit": "TS_NODE_PROJECT=tsconfig.tests.json ts-node scripts/emit-mock.ts"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cucumber/cucumber": "^13.3.0",
    "@types/jest": "^30.0.0",
    "expect": "^30.5.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
