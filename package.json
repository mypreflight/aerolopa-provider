{
  "name": "aerolopa-provider",
  "version": "1.0.1",
  "description": "AeroLOPA seat map fetcher, deployed as an internal App Platform service",
  "author": "mypreflight",
  "license": "Unlicense",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:functional": "cucumber-js",
    "openapi:emit": "ts-node scripts/emit-openapi.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@cucumber/cucumber": "^11.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "expect": "^29.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
