{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "packages/aerolopa/seatmap/src/**/*",
      "features/**/*",
      "scripts/**/*",
      "*.json",
      "*.js",
      "!openapi.json",
      "!docker/mock/aerolopa.json",
      "!**/lib"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "json": {},
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
